!.vscode/extensions.json

# --- Node ---
node_modules/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Build artifacts ---
dist/
build/
graphify-out/

# --- Logs ---
*.log

# --- Test / type-check caches ---
.coverage
.pytest_cache/
.mypy_cache/

# --- Terraform ---
.terraform/
*.tfstate*

# --- AI provider secrets / local scratch ---
*.local
.worktrees/
