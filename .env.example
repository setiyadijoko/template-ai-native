# =============================================================================
# .env.example — sample environment variables for the template-ai-native stack.
# Copy to `.env` (which is gitignored) and fill in real values.
# This file contains ONLY names, descriptions, and safe placeholders.
# NEVER commit real secrets. Manage credentials in a secret manager.
# =============================================================================

# --- Application ---
# Runtime environment selector (local | dev | staging | prod).
APP_ENV=local
# Structured logging verbosity (debug | info | warn | error).
LOG_LEVEL=info

# --- AI Provider ---
# Which provider backend to use (e.g. openai, anthropic). Leave empty until configured.
AI_PROVIDER=
# Default model identifier (e.g. gpt-4o-mini). Leave empty until configured.
AI_MODEL=
# API key for the AI provider. Set this only in your secret manager, never here.
AI_API_KEY=<set-in-secret-manager>

# --- Observability ---
# OpenTelemetry OTLP exporter endpoint (e.g. http://localhost:4317). Leave empty to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Deployment ---
# Target deployment platform identifier (e.g. cloudflare-workers, fly, lambda).
DEPLOY_TARGET=
